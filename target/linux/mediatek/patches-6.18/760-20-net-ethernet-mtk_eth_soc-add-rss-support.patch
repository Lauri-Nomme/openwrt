 	struct {
 		u32	qtx_cfg;	/* tx queue configuration */
@@ -1464,6 +1495,7 @@ struct mtk_mac {
 	struct mtk_hw_stats		*hw_stats;
 	__be32				hwlro_ip[MTK_MAX_LRO_IP_CNT];
 	int				hwlro_ip_cnt;
